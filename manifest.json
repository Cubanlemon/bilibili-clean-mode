{
  "manifest_version": 3,
  "name": "哔哩哔哩纯净模式",
  "version": "0.5.1",
  "description": "一键把哔哩哔哩网页版变成「只剩视频画面」并自动进入全屏：进度条、音量条、弹幕栏、推荐区、评论区全部隐去；再按一下全部恢复。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "哔哩哔哩纯净模式（Alt+L）"
  }
}
